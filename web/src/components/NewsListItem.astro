---
import type { NewsItem } from '../types';

interface Props {
  news: NewsItem;
  featured?: boolean;
}

const { news} = Astro.props;
const cleanTitle = news.title.replace(/<[^>]*>?/gm, '');
---

<a href={news.url} target="_blank" rel="noopener noreferrer" class="group block py-3 border-b border-gray-100 last:border-0 hover:bg-gray-50 -mx-2 px-2 transition-colors duration-200">
    <article>
        <h3 class:list={[
            "font-medium text-gray-900 group-hover:text-black leading-snug text-sm",
        ]}>
            {cleanTitle}
        </h3>
    </article>
</a>
