---
import NewsFeed from "../components/NewsFeed.svelte";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Shiori News</title>
  </head>
  <body class="bg-[#F2F0E9] text-gray-900 font-sans min-h-screen selection:bg-black selection:text-white">
    <header class="border-b border-gray-200 bg-white/80 backdrop-blur-md sticky top-0 z-10">
      <div class="max-w-7xl mx-auto px-4 py-6 flex justify-between items-end">
        <div>
          <h1 class="text-4xl font-black tracking-tighter leading-none">SHIORI.</h1>
          <p class="text-sm text-gray-500 mt-1 font-mono tracking-wide">
            Indonesian market feeds.
          </p>
        </div>
        <div class="text-right hidden sm:block">
          <div class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-1">Edition</div>
          <div class="text-sm font-mono text-gray-900">
            {new Date().toLocaleDateString("en-US", {
              weekday: "long",
              day: "numeric",
              month: "long",
              year: "numeric",
            })}
          </div>
        </div>
      </div>
    </header>

    <main class="min-h-[calc(100vh-100px)]">
      <NewsFeed client:load />
    </main>

    <footer class="border-t border-gray-200 py-8 mt-12 bg-white">
      <div class="max-w-7xl mx-auto px-4 text-center text-gray-400 font-mono text-xs">
        SHIORI &copy; 2026
      </div>
    </footer>
  </body>
</html>